# Copy to .env and fill in real values. Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Cairo

DATABASE_URL=postgres://phinox:phinox@db:5432/phinox
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Payment gateways (Phase 4) — placeholders only, not used in Phase 1
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
VALU_API_KEY=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# Object storage (staging/prod)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring (prod)
SENTRY_DSN=

# Which design-token family (a|b) new/undecided pages should default to —
# see IMPLEMENTATION_PLAN.md §1, open question #5.
PHINOX_DEFAULT_TOKEN_FAMILY=a
